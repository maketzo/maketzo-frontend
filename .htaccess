# ──────────────────────────────────────────────────────────────────────────────
# Host-conditional basic-auth gate. ONE file across all three branches
# (dev / staging / main) — bit-identical, no per-branch divergence to strip
# during promotion.
#
# Apache 2.4 / LiteSpeed evaluate the <If> blocks per-request: when the
# inbound HTTP_HOST matches a preview tier, AuthType + AuthUserFile + Require
# kick in. Prod (maketzo.co) doesn't match either, so no auth fires and the
# tier stays public.
#
# AuthUserFile paths are tier-specific because the .htpasswd files live in
# each tier's DOCUMENT_ROOT — that's a hardcoded literal path inside the <If>
# branch for that host. The same .htaccess file evaluates both branches but
# only the matching one's directives take effect, so it's safe.
#
# To rotate creds: regenerate SHA1 hash, update .htpasswd in BOTH dev+staging
# tier folders, redeploy. (Or consolidate to a shared .htpasswd at the home
# dir level in a future cleanup — out of scope for this refactor.)
# ──────────────────────────────────────────────────────────────────────────────
<If "%{HTTP_HOST} == 'dev.maketzo.co'">
    AuthType Basic
    AuthName "MAKETZO Preview"
    AuthUserFile "/home/u775138918/domains/maketzo.co/public_html/dev/.htpasswd"
    Require valid-user
</If>
<ElseIf "%{HTTP_HOST} == 'staging.maketzo.co'">
    AuthType Basic
    AuthName "MAKETZO Preview"
    AuthUserFile "/home/u775138918/domains/maketzo.co/public_html/staging/.htpasswd"
    Require valid-user
</ElseIf>

<Files ".htpasswd">
    Require all denied
</Files>

# MIME types for modern image formats
# Hostinger / LiteSpeed do not register these by default; without this block
# AVIF is served as text/plain and some browsers refuse it.
AddType image/avif .avif
AddType image/webp .webp

# Clean URLs for marketing pages
# Maps /system -> system.html, /indicators -> indicators.html, etc. without the .html suffix.
# Trailing slashes get redirected (301) to the non-slash canonical form so SEO
# and analytics don't fork into /pricing and /pricing/.
RewriteEngine On

# Unsubscribe + Resubscribe — forward user-facing URLs to the backend.
# Email links and one-click reversal use https://maketzo.co/(un|re)subscribe
# so visible URLs match the brand and stay stable if the backend ever moves.
# Token lookup, DB write, and redirect-to-/unsubscribed all happen on the
# backend (api.maketzo.co). QSA preserves ?token=...
RewriteRule ^unsubscribe$ https://api.maketzo.co/unsubscribe [R=302,L,QSA]
RewriteRule ^resubscribe$ https://api.maketzo.co/resubscribe [R=302,L,QSA]

# Legacy /edge → /indicators (2026-05-28). edge.html was renamed to
# indicators.html so Edge AND Pulse can be presented as first-class peers
# on a single canonical page. Keeps every previously-shared /edge link
# alive — newsletter footers, blog post bylines, social shares, etc.
# 301 (permanent) so search engines update their index promptly.
RewriteRule ^edge/?$ /indicators [R=301,L]

# Tier-aware /app redirect. Every marketing page's "Log In" nav link points to
# /app (relative). Same-domain link works for SEO + survives port changes, but
# users must be routed to the matching app subdomain per tier so the auth flow
# (signup.html → /app, login.html → /app, every nav-login-btn) lands on the
# real app and not a 404 on /app of the marketing site. Added 2026-05-24 after
# the staging signup flow 404'd on /app — see plans for the full incident.
# QSA preserves ?return=foo, ?ref=bar, etc. from signup query params.
RewriteCond %{HTTP_HOST} ^dev\.maketzo\.co$ [NC]
RewriteRule ^app/?$ https://dev-app.maketzo.co/ [R=302,L,QSA]
RewriteCond %{HTTP_HOST} ^staging\.maketzo\.co$ [NC]
RewriteRule ^app/?$ https://staging-app.maketzo.co/ [R=302,L,QSA]
RewriteCond %{HTTP_HOST} ^maketzo\.co$ [NC]
RewriteRule ^app/?$ https://app.maketzo.co/ [R=302,L,QSA]

# Tier-aware /admin redirect. The static admin.html in this repo is dead
# code as of 2026-05-18 — the active admin console lives on the API origin
# (cookie auth needs to set httpOnly cookies on the API domain). Without
# this redirect, hostinger still serves the stale admin.html and operators
# can land on the wrong page (see memory/reference-admin-console-lives-on-
# api-origin.md). Permanent (R=301). QSA carries ?token=... for reset URLs.
RewriteCond %{HTTP_HOST} ^dev\.maketzo\.co$ [NC]
RewriteRule ^admin(/.*)?$ https://dev-api.maketzo.co/admin$1 [R=301,L,QSA]
RewriteCond %{HTTP_HOST} ^staging\.maketzo\.co$ [NC]
RewriteRule ^admin(/.*)?$ https://staging-api.maketzo.co/admin$1 [R=301,L,QSA]
RewriteCond %{HTTP_HOST} ^maketzo\.co$ [NC]
RewriteRule ^admin(/.*)?$ https://api.maketzo.co/admin$1 [R=301,L,QSA]

# Strip trailing slashes (except the bare /).
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# If a real file or directory exists for the URL, serve it as-is.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Knowledge Center public teaser pages (Phase B). ONE template (learn.html)
# serves every /learn/<slug>: it reads the slug from the URL path and fetches
# the teaser from api.maketzo.co/kb/public/<slug>. Must precede the generic
# .html rule (there are no per-slug files under /learn/). The URL stays
# /learn/<slug> for the browser; learn.html parses location.pathname.
RewriteRule ^learn/[a-z0-9][a-z0-9-]*$ /learn.html [L]

# Otherwise, if a matching .html file exists, serve it without revealing the suffix.
# Pattern matches single-segment paths (/system -> system.html) AND multi-segment
# paths (/blog/some-slug -> blog/some-slug.html). The [^.]+ excludes paths
# containing a literal dot (so /assets/foo.png isn't rewritten), but allows
# slashes — needed for the auto-published blog posts under /blog/<slug>.
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^.]+)$ /$1.html [L]

# Cache static assets aggressively. HTML stays fresh.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
